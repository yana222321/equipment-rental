# Скопируйте файл в .env и настройте под своё окружение.

# SQLite (по умолчанию, если переменная не задана)
# DATABASE_URL=sqlite:///./workshop.db

# PostgreSQL (нужен psycopg2-binary)
# DATABASE_URL=postgresql+psycopg2://workshop:workshop@localhost:5432/workshop

# Обязательно смените в продакшене
JWT_SECRET=dev-secret-please-change-in-production

# Время жизни access-токена в минутах (12 часов по умолчанию)
ACCESS_TOKEN_TTL_MINUTES=720
